<Window x:Class="CodexTaskMonitor.App.DesktopPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTaskMonitor.App"
        Width="126" Height="126" MinWidth="48" MaxWidth="430" MinHeight="48" MaxHeight="510"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True"
        Background="Transparent" Topmost="True" Loaded="OnLoaded" Closing="OnClosing">
    <Grid x:Name="PetLayout" MouseLeftButtonDown="OnDragStart">
        <Grid.Resources>
            <local:FloatingStatusBrushConverter x:Key="FloatingStatusBrush"/>
            <Style x:Key="PetTaskButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#222222"/>
                <Setter Property="BorderBrush" Value="#EAEAEA"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TaskBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TaskBorder" Property="Background" Value="#F2F2F2"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TaskBorder" Property="Background" Value="#F2F2F2"/><Setter TargetName="TaskBorder" Property="BorderBrush" Value="#262626"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TaskBorder" Property="Background" Value="#E5E5E5"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="PetSurfaceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="126"/></Grid.RowDefinitions>
        <Border x:Name="TaskListPanel" Grid.Row="0" Width="404" MaxHeight="378" HorizontalAlignment="Right"
                Margin="0,0,0,6" Padding="14" Background="White" BorderBrush="#303030" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="Codex 任务" Foreground="#202020" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#656565" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="58" Height="58" IsHitTestVisible="False">
                        <Border.Background><ImageBrush ImageSource="/CodexTaskMonitor;component/Assets/TaskPaperWorker.png" Viewbox="0.2,0.18,0.63,0.63" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Border.Background>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                        <Button Command="{Binding ShowTaskCenterCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                Background="White" BorderBrush="#DFDFDF" Content="&#xE8A5;" ToolTip="打开任务中心" Margin="0,0,5,0"/>
                        <Button Command="{Binding ToggleExpandedCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                Background="White" BorderBrush="#DFDFDF" Content="&#xE70E;" ToolTip="收起任务列表"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" BorderBrush="#E6E6E6" BorderThickness="0,0,0,1" Margin="0,0,0,3">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentButton}" Padding="6,9" FontSize="11" GroupName="PetCategory"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedView}, ConverterParameter=attention}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="attention">
                            <TextBlock><Run Text="需处理 "/><Run Text="{Binding AttentionCount}" FontWeight="SemiBold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" Padding="6,9" FontSize="11" GroupName="PetCategory"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedView}, ConverterParameter=active}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="active">
                            <TextBlock><Run Text="进行中 "/><Run Text="{Binding RunningCount}" FontWeight="SemiBold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" Padding="6,9" FontSize="11" GroupName="PetCategory"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedView}, ConverterParameter=recent}"
                                     Command="{Binding SelectCategoryCommand}" CommandParameter="recent">
                            <TextBlock><Run Text="最近完成 "/><Run Text="{Binding RecentCount}" FontWeight="SemiBold"/></TextBlock>
                        </RadioButton>
                    </UniformGrid>
                </Border>
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="TaskListScroller" MaxHeight="244" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasCategoryTasks, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl ItemsSource="{Binding CategoryTasks}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource PetTaskButton}" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding FullDescription}" Margin="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{Binding Status, Converter={StaticResource FloatingStatusBrush}}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#222222" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource FloatingStatusBrush}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SecondaryText}" Foreground="#686868" FontSize="10" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#686868" FontSize="10" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Margin="0,10,0,12" HorizontalAlignment="Center" Visibility="{Binding HasCategoryTasks, Converter={StaticResource InverseBoolVisibility}}">
                        <Image Source="/CodexTaskMonitor;component/Assets/TaskPaperWorker.png" Width="90" Height="90" Stretch="Uniform"/>
                        <TextBlock Text="{Binding EmptyTitle}" Foreground="#656565" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FooterText}" FontSize="10" Foreground="#686868" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Width="26" Height="26" Command="{Binding ToggleDoNotDisturbCommand}" ToolTip="{Binding DoNotDisturbTooltip}" Content="&#xE708;">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="White"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsDoNotDisturb}" Value="True"><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="PetBody" Grid.Row="1" HorizontalAlignment="Right" Width="126" Height="126">
            <Button x:Name="PetSurface" Command="{Binding ToggleExpandedCommand}" Style="{StaticResource PetSurfaceButton}" ToolTip="{Binding Summary}"
                    PreviewMouseLeftButtonDown="OnPetPointerDown" PreviewMouseMove="OnPetPointerMove" PreviewMouseLeftButtonUp="OnPetPointerUp">
                <Grid>
                    <Ellipse Width="112" Height="112" Fill="White" Stroke="#303030" StrokeThickness="1.5"/>
                    <local:SpritePetControl x:Name="PixelPet" SpriteSheet="{Binding SelectedPet.SpriteSheet}" Width="98" Height="98"
                                           Columns="{Binding SelectedPet.Columns}" Rows="{Binding SelectedPet.Rows}" State="{Binding SpriteState}"
                                           AnimationRow="{Binding SpriteAnimationRow}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Button>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6,8,5,0" Width="26" Height="26" Background="#242424" CornerRadius="13" BorderBrush="White" BorderThickness="2" IsHitTestVisible="False">
                <TextBlock Text="{Binding RunningCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Ellipse Width="13" Height="13" Fill="{Binding Status, Converter={StaticResource FloatingStatusBrush}}" Stroke="White" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,9" IsHitTestVisible="False"/>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,8,0,0" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11"
                    Background="White" BorderBrush="#D0D0D0" Content="&#xE8BB;" Click="OnCompactClick" ToolTip="收纳为小圆球"/>
        </Grid>
        <Button x:Name="CompactOrb" Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PetSurfaceButton}"
                Visibility="Collapsed" Click="OnRestoreClick" PreviewMouseLeftButtonDown="OnCompactPointerDown" PreviewMouseMove="OnCompactPointerMove"
                PreviewMouseLeftButtonUp="OnCompactPointerUp" ToolTip="展开桌宠 · 按住可拖动">
            <Grid>
                <Ellipse Width="42" Height="42" Fill="White" Stroke="#242424" StrokeThickness="1.5"/>
                <Ellipse Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource FloatingStatusBrush}}" Stroke="White" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"/>
                <TextBlock Text="{Binding CompactCount}" Foreground="#242424" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Button>
    </Grid>
</Window>
