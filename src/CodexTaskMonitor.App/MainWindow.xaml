<Window x:Class="CodexTaskMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTaskMonitor.App"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Codex 任务提示器" Width="1100" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Microsoft YaHei UI, Segoe UI" Closing="OnClosing">
    <Window.Resources>
        <local:FloatingStatusBrushConverter x:Key="TaskInk"/>
        <Style x:Key="TaskListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F7F7F7"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F0F0F0"/><Setter TargetName="Frame" Property="BorderBrush" Value="#303030"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#303030"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NoteLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#686868"/></Style>
        <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="Codex Task Monitor" LeftClickCommand="{Binding ShowWindowCommand}" MenuActivation="RightClick">
            <tb:TaskbarIcon.IconSource><tb:GeneratedIconSource Text="C" FontFamily="Segoe UI" FontWeight="Bold" FontSize="35" Foreground="White" Background="#202020" CornerRadius="8"/></tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu><ContextMenu>
                <MenuItem Header="打开任务中心" Click="OnTrayOpenClick"/>
                <MenuItem Header="暂停 / 恢复监听" Click="OnTrayPauseClick"/>
                <MenuItem Header="开启 / 关闭勿扰" Click="OnTrayDoNotDisturbClick"/>
                <MenuItem Header="显示 / 隐藏桌面状态" Click="OnTrayToggleDesktopPetClick"/>
                <Separator/><MenuItem Header="退出" Click="OnTrayExitClick"/>
            </ContextMenu></tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="70"/><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="52" Height="56" HorizontalAlignment="Left">
                        <Border.Background><ImageBrush ImageSource="/CodexTaskMonitor;component/Assets/TaskPaperWorker.png" Viewbox="0.2,0.18,0.63,0.63" Stretch="Uniform"/></Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="任务中心" FontSize="24" FontWeight="Bold" Foreground="#202020"/>
                        <TextBlock Text="Codex Task Monitor" FontSize="11" Foreground="#686868" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="桌宠库" Height="36" Click="OnPetPickerClick" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshNowCommand}" ToolTip="立即刷新"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE9D9;" Click="OnDiagnosticsClick" ToolTip="监控状态" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnSettingsClick" ToolTip="设置" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="OnHideClick" ToolTip="隐藏到托盘" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding WorkspaceSummary}" FontSize="15" FontWeight="SemiBold" Foreground="#242424" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding WorkspaceDetail}" FontSize="11" Foreground="#686868" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleDoNotDisturbCommand}" Height="36" ToolTip="切换勿扰模式">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoNotDisturb}" Value="True"><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE708;" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding DoNotDisturbButtonText}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding TogglePauseCommand}" Height="36" Margin="8,0,0,0" ToolTip="暂停或恢复监听">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Background" Value="#FFF4DE"/><Setter Property="Foreground" Value="#7A5000"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding PauseGlyph}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding PauseButtonText}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="24,0,24,12">
                <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding SelectedView, Converter={StaticResource SelectedView}, ConverterParameter=active}" Command="{Binding SelectViewCommand}" CommandParameter="active"><TextBlock><Run Text="进行中 "/><Run Text="{Binding RunningCount}"/></TextBlock></RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding SelectedView, Converter={StaticResource SelectedView}, ConverterParameter=attention}" Command="{Binding SelectViewCommand}" CommandParameter="attention"><TextBlock><Run Text="需处理 "/><Run Text="{Binding AttentionCount}"/></TextBlock></RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" IsChecked="{Binding SelectedView, Converter={StaticResource SelectedView}, ConverterParameter=recent}" Command="{Binding SelectViewCommand}" CommandParameter="recent"><TextBlock><Run Text="最近完成 "/><Run Text="{Binding RecentCount}"/></TextBlock></RadioButton>
                    </StackPanel>
                    <TextBlock Text="{Binding VisibleTaskCountText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource NoteLabel}"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="164"/><ColumnDefinition Width="116"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Height="36" Padding="32,7,10,7" ToolTip="搜索任务、项目或活动"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="搜索任务、项目或活动" VerticalAlignment="Center" Margin="32,0,0,0" Foreground="#686868" FontSize="12" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Height="36" Padding="8,4" Margin="0,0,10,0" ToolTip="筛选项目"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Height="36" Padding="8,4" ToolTip="任务排序"/>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="清空筛选" Command="{Binding ResetFiltersCommand}" Margin="8,0,0,0" Visibility="{Binding HasFilters, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
                <Grid Margin="24,0,16,0">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding ViewTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#444444"/>
                    <ListBox x:Name="TaskList" Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" BorderThickness="0" Background="White"
                             ItemContainerStyle="{StaticResource TaskListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnTaskDoubleClick" PreviewKeyDown="OnTaskKeyDown">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="10,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Status, Converter={StaticResource TaskInk}}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#242424" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Project}" Style="{StaticResource NoteLabel}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text=" · " Style="{StaticResource NoteLabel}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Activity}" Style="{StaticResource NoteLabel}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource TaskInk}}"/>
                                        <TextBlock Text="{Binding LastActivityText}" Style="{StaticResource NoteLabel}" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding ChildrenSummary}" Style="{StaticResource NoteLabel}" Margin="10,0,0,0" Visibility="{Binding HasChildren, Converter={StaticResource BoolVisibility}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="#444444" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="已用时" Style="{StaticResource NoteLabel}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="32" Content="&#xE72A;" ToolTip="在 Codex 中打开"
                                        Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Tasks.Count, Converter={StaticResource ZeroVisibility}}" MaxWidth="380">
                        <Image Source="/CodexTaskMonitor;component/Assets/TaskPaperWorker.png" Width="110" Height="110" Stretch="Uniform"/>
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="14" Foreground="#555555" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,14"/>
                        <Button Content="清空筛选" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" Visibility="{Binding HasFilters, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="18,0,18,16" Visibility="{Binding ShowRecentTasks, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="桌面伙伴" FontSize="12" FontWeight="SemiBold" Foreground="#444444"/>
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <local:SpritePetControl SpriteSheet="{Binding SelectedPet.SpriteSheet}" Columns="{Binding SelectedPet.Columns}" Rows="{Binding SelectedPet.Rows}" Width="72" Height="72"
                                                        State="{Binding CompanionState}" AnimationRow="{Binding CompanionAnimationRow}" IsAnimationEnabled="{Binding PetAnimationsEnabled}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding SelectedPet.Name}" FontSize="13" FontWeight="SemiBold" Foreground="#242424" TextWrapping="Wrap" MaxHeight="40"/>
                                    <Button Content="更换伙伴" Click="OnPetPickerClick" Padding="0,5" FontSize="11" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="显示桌宠" Click="OnShowPetClick" Height="32" FontSize="12"/>
                        </StackPanel>
                        <Grid Height="46" Margin="18,0,18,12" Visibility="{Binding HasTaskDetails, Converter={StaticResource BoolVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <local:SpritePetControl SpriteSheet="{Binding SelectedPet.SpriteSheet}" Columns="{Binding SelectedPet.Columns}" Rows="{Binding SelectedPet.Rows}" Width="40" Height="40"
                                                    State="{Binding CompanionState}" AnimationRow="{Binding CompanionAnimationRow}" IsAnimationEnabled="False"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="桌面伙伴" Style="{StaticResource NoteLabel}"/>
                                <TextBlock Text="{Binding SelectedPet.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE8A7;" ToolTip="显示桌宠" Click="OnShowPetClick" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,14" x:Name="InspectorRoot">
                            <StackPanel>
                                <StackPanel Visibility="{Binding ShowRecentTasks, Converter={StaticResource BoolVisibility}}">
                                    <Border Height="1" Background="#E5E5E5" Margin="0,0,0,16"/>
                                    <TextBlock Text="刚刚完成的事" FontSize="13" FontWeight="SemiBold" Foreground="#242424" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding RecentTasks}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Style="{StaticResource QuietAction}" Command="{Binding DataContext.InspectRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#303030" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastActivityText}" Style="{StaticResource NoteLabel}" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="最近 24 小时还没有完成记录" Style="{StaticResource NoteLabel}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding RecentTasks.Count, Converter={StaticResource ZeroVisibility}}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasTaskDetails, Converter={StaticResource BoolVisibility}}">
                                    <Border Height="1" Background="#E5E5E5" Margin="0,0,0,14"/>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="任务详情" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11" Content="&#xE711;" ToolTip="关闭任务详情" HorizontalAlignment="Right" Command="{Binding ClearSelectionCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedTask.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#242424" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedTask.StatusLabel}" FontSize="12" Foreground="{Binding SelectedTask.Status, Converter={StaticResource TaskInk}}" Margin="0,8,0,16"/>
                                    <Button Content="在 Codex 中打开" Style="{StaticResource PrimaryButton}" Command="{Binding OpenTaskCommand}" CommandParameter="{Binding SelectedTask}" Margin="0,0,0,16"/>
                                    <TextBlock Text="项目" Style="{StaticResource NoteLabel}"/>
                                    <TextBlock Text="{Binding SelectedTask.Project}" FontSize="12" Foreground="#303030" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                    <TextBlock Text="当前活动" Style="{StaticResource NoteLabel}"/>
                                    <TextBlock Text="{Binding SelectedTask.Activity}" FontSize="12" Foreground="#303030" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="已用时" Style="{StaticResource NoteLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedTask.DurationText}" FontSize="12"/>
                                    </Grid>
                                    <TextBlock Text="最后活动" Style="{StaticResource NoteLabel}"/>
                                    <TextBlock Text="{Binding SelectedTask.LastActivityClock}" FontSize="12" Foreground="#303030" Margin="0,4,0,14"/>
                                    <TextBlock Text="开始时间" Style="{StaticResource NoteLabel}"/>
                                    <TextBlock Text="{Binding SelectedTask.StartedAtText}" FontSize="12" Foreground="#303030" Margin="0,4,0,14"/>
                                    <TextBlock Text="工作目录" Style="{StaticResource NoteLabel}"/>
                                    <TextBlock Text="{Binding SelectedTask.DirectoryPath}" FontSize="11" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,16"/>
                                    <TextBlock Text="子任务" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,8" Visibility="{Binding SelectedTask.HasChildren, Converter={StaticResource BoolVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding SelectedTask.Children}" Visibility="{Binding SelectedTask.HasChildren, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Style="{StaticResource QuietAction}" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="打开子任务">
                                                <StackPanel><TextBlock Text="{Binding AgentLabel}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Activity}" FontSize="11" Foreground="#686868" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="4" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource NoteLabel}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding ListenerBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding ListenerStatusText}" Style="{StaticResource NoteLabel}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ProgressBar Height="2" VerticalAlignment="Top" Foreground="#242424" Background="Transparent" IsIndeterminate="{Binding RefreshNowCommand.IsRunning}" Visibility="{Binding RefreshNowCommand.IsRunning, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
    </Grid>
</Window>
