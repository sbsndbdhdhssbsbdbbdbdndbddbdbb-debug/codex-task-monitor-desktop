<Window x:Class="CodexTaskMonitor.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="372"
        SizeToContent="Height"
        MaxHeight="210"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonUp="OnMouseLeftButtonUp">
    <Border Background="#FFFCFB"
            BorderBrush="#D8DEDC"
            BorderThickness="1"
            CornerRadius="7"
            Padding="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="5"
                              Direction="270"
                              Opacity="0.22"
                              Color="#20312C"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentBar"
                    Grid.Column="0"
                    CornerRadius="2"
                    Background="#1A775A"/>
            <StackPanel Grid.Column="2">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="KindText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#52605C"/>
                    <TextBlock x:Name="CountText"
                               DockPanel.Dock="Right"
                               FontSize="12"
                               Foreground="#727D79"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock x:Name="TitleText"
                           Margin="0,7,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#17201D"
                           TextWrapping="Wrap"
                           MaxHeight="46"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ActivityText"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="#5D6965"
                           TextWrapping="Wrap"
                           MaxHeight="36"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Margin="0,10,0,0"
                           Text="点击查看对应 Codex 任务"
                           FontSize="11"
                           Foreground="#7C8783"/>
            </StackPanel>
            <TextBlock Grid.Column="3"
                       Text="&#xE72A;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="15"
                       Foreground="#55615D"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       ToolTip="打开任务"/>
        </Grid>
    </Border>
</Window>
